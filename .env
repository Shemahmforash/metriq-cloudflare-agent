# Committed template — variable NAMES only, never values.
# Copy this file to .env.local and fill in real values there.
# .env.local is gitignored and overrides .env at runtime.
#
# Load this into your shell before launching Claude Code so .mcp.json
# can interpolate ${METRIQ_API_KEY}. Recommended approaches:
#   - direnv: add `dotenv .env.local` to .envrc and `direnv allow`
#   - manual: `set -a; source .env.local; set +a` in your shell
#   - mise / asdf: configure .tool-versions or .mise.toml accordingly

# Bearer token from Metriq UI → Settings → Agents.
METRIQ_API_KEY=

# Metriq MCP HTTP endpoint. Point this at your own Metriq instance.
METRIQ_MCP_URL=https://your-metriq-instance.example.com/api/v1/mcp

# Bearer token gating the public Worker control + debug routes
# (/wake /stop /pause /resume /debug). Production: set via
# `wrangler secret put CONTROL_TOKEN` — never commit a real value here.
# CONTROL_TOKEN=
